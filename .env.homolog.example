# ===========================================
# Homolog Environment Variables
# ===========================================
# Copy this file to .env on the VPS server
# Usage: cp .env.homolog.example .env
# Then edit with your actual values

# -------------------------------------------
# Docker Compose Variables
# -------------------------------------------
# Used by docker-compose.homolog.yml

# Database credentials (CHANGE THESE!)
DB_DATABASE=simulados_db
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_USERNAME=simulados_user
DB_PASSWORD=CHANGE_ME_USER_PASSWORD

# Traefik ACME email for Let's Encrypt notifications
ACME_EMAIL=admin@mydev.com.br

# -------------------------------------------
# Laravel Application Variables
# -------------------------------------------
# Copy these to laravel/.env on the VPS

# APP_NAME="Operação Alfa"
# APP_ENV=staging
# APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
# APP_DEBUG=false
# APP_URL=https://operacao-alfa.homolog.mydev.com.br

# # Trust Traefik proxy headers (IMPORTANT for HTTPS)
# TRUSTED_PROXIES=*

# # Database (internal Docker network)
# DB_CONNECTION=mysql
# DB_HOST=simulados-db
# DB_PORT=3306
# DB_DATABASE=simulados_db
# DB_USERNAME=simulados_user
# DB_PASSWORD=CHANGE_ME_USER_PASSWORD

# # Redis (internal Docker network)
# REDIS_HOST=simulados-redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# # Session/Cache/Queue via Redis
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# # Logging
# LOG_CHANNEL=stack
# LOG_LEVEL=info
